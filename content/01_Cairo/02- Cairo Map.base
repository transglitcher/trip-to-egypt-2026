formulas:
  google maps link: link("https://www.google.com/maps/search/" + file.name.replace(" ","+"),"Google Maps")
views:
  - type: map
    name: map view
    filters:
      and:
        - file.folder == "content/01_Cairo"
    order:
      - file.name
      - coordinates
      - formula.google maps link
    mapHeight: 360
    center: "[29.98397, 31.22461]"
    defaultZoom: 9.6
    mapTiles:
      - https://tiles.openfreemap.org/styles/liberty
    coordinates: note.coordinates
    markerIcon: note.icon
    markerColor: note.color
